*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz
*.bz2
*.xz

# ================================
# Project Specific
# ================================
# Keep these templates but ignore filled versions
memory/archive/
docs/generated/

# Ignore local overrides
*.local.json
*.local.yml
*.local.yaml

# Test output
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# Claude Code / AI tools
.claude/logs/
.claude/cache/
.continue/cache/

# SSH keys (NEVER commit these)
*.pub
id_*
!id_*.pub.example

# VPN configs (contains certificates)
*.ovpn
!*.ovpn.example

# Keep example files
!.env.example
!config.example.json
!*.example.*
