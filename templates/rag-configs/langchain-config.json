{
  "version": "1.0",
  "name": "langchain-rag-config",
  "description": "LangChain RAG system configuration",
  "llm": {
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "model": "llama3:8b",
    "temperature": 0.7,
    "max_tokens": 2048,
    "streaming": true,
    "fallback_models": [
      {
        "provider": "anthropic",
        "model": "claude-sonnet-4",
        "api_key_env": "ANTHROPIC_API_KEY"
      },
      {
        "provider": "openrouter",
        "model": "anthropic/claude-sonnet-4",
        "api_key_env": "OPENROUTER_API_KEY"
      }
    ]
  },
  "embeddings": {
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "model": "nomic-embed-text",
    "dimensions": 768,
    "batch_size": 32,
    "fallback": {
      "provider": "openai",
      "model": "text-embedding-3-small",
      "api_key_env": "OPENAI_API_KEY"
    }
  },
  "vector_store": {
    "type": "chroma",
    "persist_directory": "./data/chroma_db",
    "collection_name": "documents",
    "distance_metric": "cosine",
    "max_batch_size": 100
  },
  "retrieval": {
    "search_type": "similarity",
    "k": 4,
    "fetch_k": 20,
    "score_threshold": 0.7,
    "reranking": {
      "enabled": true,
      "model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
      "top_n": 3
    }
  },
  "document_processing": {
    "chunk_size": 1000,
    "chunk_overlap": 200,
    "separators": ["\n\n", "\n", ". ", " ", ""],
    "add_metadata": true,
    "loaders": {
      "pdf": {
        "class": "PyPDFLoader",
        "options": {
          "extract_images": false
        }
      },
      "text": {
        "class": "TextLoader",
        "options": {
          "encoding": "utf-8"
        }
      },
      "markdown": {
        "class": "UnstructuredMarkdownLoader",
        "options": {
          "mode": "elements"
        }
      },
      "html": {
        "class": "BSHTMLLoader",
        "options": {
          "open_encoding": "utf-8"
        }
      },
      "csv": {
        "class": "CSVLoader",
        "options": {
          "csv_args": {
            "delimiter": ","
          }
        }
      },
      "json": {
        "class": "JSONLoader",
        "options": {
          "jq_schema": "."
        }
      }
    }
  },
  "chain": {
    "type": "conversational_retrieval",
    "memory": {
      "type": "buffer",
      "k": 5,
      "return_messages": true
    },
    "prompt_template": {
      "system": "You are a helpful AI assistant with access to a knowledge base. Use the following context to answer the user's question. If you don't know the answer based on the context, say so clearly.\n\nContext:\n{context}\n\nChat History:\n{chat_history}",
      "human": "{question}"
    },
    "combine_docs_chain": {
      "type": "stuff",
      "document_variable_name": "context"
    }
  },
  "monitoring": {
    "enabled": true,
    "langsmith": {
      "enabled": false,
      "project_name": "rag-project",
      "api_key_env": "LANGCHAIN_API_KEY"
    },
    "prometheus": {
      "enabled": true,
      "port": 9090
    },
    "logging": {
      "level": "INFO",
      "format": "json",
      "log_file": "logs/rag.log"
    }
  },
  "performance": {
    "cache": {
      "enabled": true,
      "type": "redis",
      "host": "localhost",
      "port": 6379,
      "db": 1,
      "ttl": 3600
    },
    "rate_limiting": {
      "enabled": true,
      "requests_per_minute": 60,
      "burst": 10
    }
  },
  "guardrails": {
    "input_validation": {
      "max_length": 4000,
      "blocked_patterns": []
    },
    "output_validation": {
      "min_length": 10,
      "max_length": 2000,
      "content_filter": {
        "enabled": false
      }
    }
  }
}
