# ================================
# Meta-Env Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ================================

# ================================
# Application Settings
# ================================
NODE_ENV=development
PORT=3000
API_PORT=8000
HOST=localhost
TIMEZONE=UTC

# Application name and version
APP_NAME=meta-env
APP_VERSION=1.0.0

# ================================
# AI Model API Keys
# ================================
# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API (GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-your-openai-key-here

# OpenRouter (unified API for multiple models)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Hugging Face (for model downloads)
HUGGINGFACE_API_KEY=hf_your-key-here

# ================================
# Local LLM Configuration
# ================================
# Ollama settings (local or remote)
OLLAMA_HOST=http://localhost:11434
# For remote GPU server: http://192.168.1.100:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ================================
# Database Configuration
# ================================
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=meta_env

# Database URL (alternative to separate vars)
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/meta_env

# n8n Database (uses same PostgreSQL instance)
N8N_DB_NAME=n8n

# ================================
# Redis Configuration
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# Redis URL (alternative to separate vars)
REDIS_URL=redis://default:your_redis_password_here@localhost:6379

# Redis session configuration
REDIS_SESSION_SECRET=your-session-secret-here-min-32-chars

# ================================
# Monitoring & Observability
# ================================
# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# Prometheus
PROMETHEUS_PORT=9090

# Node Exporter
NODE_EXPORTER_PORT=9100

# ================================
# Workflow Automation (n8n)
# ================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password_here

# n8n webhook URL
WEBHOOK_URL=http://localhost:5678/

# n8n encryption key (generate with: openssl rand -base64 32)
N8N_ENCRYPTION_KEY=your-32-char-encryption-key-here

# ================================
# Docker & Container Settings
# ================================
# Portainer
PORTAINER_PORT=9000
PORTAINER_HTTPS_PORT=9443

# ================================
# Cloud Services (Optional)
# ================================
# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Google Cloud
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=
GCS_BUCKET=

# Azure
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER=

# ================================
# Authentication & Security
# ================================
# JWT Configuration
JWT_SECRET=your-jwt-secret-min-64-chars-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-here
JWT_REFRESH_EXPIRES_IN=30d

# Session configuration
SESSION_SECRET=your-session-secret-min-64-chars-here
SESSION_MAX_AGE=604800000

# OAuth (if using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ================================
# Email Configuration (Optional)
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# SendGrid alternative
SENDGRID_API_KEY=

# ================================
# Vector Database (for RAG)
# ================================
# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Pinecone
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ================================
# LangChain Configuration
# ================================
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=meta-env
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ================================
# AutoGen Configuration
# ================================
AUTOGEN_USE_DOCKER=false
AUTOGEN_MAX_CONSECUTIVE_AUTO_REPLY=10

# ================================
# GitHub Integration
# ================================
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_ORG=your-organization
GITHUB_REPO=your-repository

# ================================
# MCP (Model Context Protocol) Servers
# ================================
MCP_FILESYSTEM_PATH=./src
MCP_GITHUB_ENABLED=true
MCP_DATABASE_ENABLED=true
MCP_PROMETHEUS_ENABLED=true

# ================================
# Logging
# ================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# CORS Configuration
# ================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# ================================
# File Upload
# ================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ================================
# Caching
# ================================
CACHE_TTL=3600
CACHE_ENABLED=true

# ================================
# Development Tools
# ================================
# VS Code Server (if using code-server)
VSCODE_SERVER_PASSWORD=

# Ngrok (for local development tunneling)
NGROK_AUTH_TOKEN=

# ================================
# Testing
# ================================
TEST_DATABASE_URL=postgresql://postgres:test@localhost:5432/meta_env_test
TEST_REDIS_URL=redis://localhost:6379/1

# ================================
# CI/CD
# ================================
CI=false
DEPLOY_ENV=development

# GitHub Actions
GITHUB_ACTIONS_TOKEN=

# GitLab CI
GITLAB_CI_TOKEN=

# ================================
# Custom Application Variables
# ================================
# Add your application-specific variables below

# Feature flags
FEATURE_AI_AGENTS=true
FEATURE_RAG_SYSTEM=true
FEATURE_MONITORING=true
FEATURE_AUTOMATION=true

# Model preferences
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-4
DEFAULT_EMBEDDING_PROVIDER=ollama
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Context windows
MAX_CONTEXT_LENGTH=100000
MAX_OUTPUT_TOKENS=4096

# ================================
# Server Infrastructure (if using meta-env pattern)
# ================================
# VPS/Server information
SERVER_HOST=89.203.173.196
SSH_PORT=2260
VPN_HOST=10.8.0.1

# OpenVPN
OPENVPN_PORT=1194
OPENVPN_PROTOCOL=tcp

# ================================
# Notes
# ================================
# 1. Generate secure passwords: openssl rand -base64 32
# 2. Generate JWT secrets: openssl rand -hex 64
# 3. Keep this file in sync with .env.example
# 4. Document any new variables you add
# 5. Use different values for dev/staging/production
